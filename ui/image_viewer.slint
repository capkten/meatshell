import { Theme } from "theme.slint";

export component ImageViewer inherits Rectangle {
    in property <string> file-name;
    in property <int> index;
    in property <int> total;
    in property <image> preview-image;
    in property <string> error-msg;
    in property <bool> loading: false;
    callback close();
    callback prev();
    callback next();

    property <float> scale: 1.0;
    property <length> offset-x: 0px;
    property <length> offset-y: 0px;
    property <bool> panning: false;
    property <length> start-x;
    property <length> start-y;
    property <length> start-offset-x;
    property <length> start-offset-y;
    property <float> min-scale: 0.1;
    property <float> max-scale: 10.0;
    property <float> zoom-step: 1.15;
    property <length> header-height: 48px;

    function reset-view() {
        root.scale = 1.0;
        root.offset-x = 0px;
        root.offset-y = 0px;
    }

    function clamp-offset() {
        let max-x = root.width * root.scale * 0.55;
        let max-y = (root.height - root.header-height) * root.scale * 0.55;
        root.offset-x = clamp(root.offset-x, -max-x, max-x);
        root.offset-y = clamp(root.offset-y, -max-y, max-y);
    }

    width: 100%;
    height: 100%;
    background: #080a0fcc;

    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.close(); return accept; }
            if (e.text == Key.LeftArrow) { root.prev(); return accept; }
            if (e.text == Key.RightArrow) { root.next(); return accept; }
            if (e.text == Key.Space) { root.reset-view(); return accept; }
            return reject;
        }

    Rectangle {
        x: 16px; y: 12px; width: parent.width - 32px; height: root.header-height;
        background: #161a22ee;
        border-radius: Theme.radius-md;
        border-width: 1px; border-color: #ffffff20;
        HorizontalLayout {
            padding-left: 14px; padding-right: 8px; spacing: 10px;
            Text {
                text: root.file-name;
                color: #f4f6fb; font-size: Theme.fs-sm;
                vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
            }
            Text {
                text: root.total > 0 ? (root.index + 1) + " / " + root.total : "";
                color: #aeb6c5; font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
            Rectangle {
                width: 32px; height: 32px; border-radius: Theme.radius-sm;
                background: zoom-out.has-hover ? #ffffff20 : transparent;
                zoom-out := TouchArea {
                    clicked => { root.scale = max(root.min-scale, root.scale / root.zoom-step); root.clamp-offset(); }
                }
                Text { text: "-"; color: #f4f6fb; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text {
                text: Math.round(root.scale * 100) + "%";
                width: 54px; color: #d5dae4; font-size: Theme.fs-xs;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Rectangle {
                width: 32px; height: 32px; border-radius: Theme.radius-sm;
                background: zoom-in.has-hover ? #ffffff20 : transparent;
                zoom-in := TouchArea {
                    clicked => { root.scale = min(root.max-scale, root.scale * root.zoom-step); root.clamp-offset(); }
                }
                Text { text: "+"; color: #f4f6fb; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 32px; height: 32px; border-radius: Theme.radius-sm;
                background: close.has-hover ? #ffffff20 : transparent;
                close := TouchArea { clicked => { root.close(); } }
                Text { text: "\u{E5CD}"; font-family: "Material Icons"; color: #f4f6fb;
                       font-size: Theme.fs-md; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    Rectangle {
        x: 16px; y: root.header-height + 20px;
        width: parent.width - 32px; height: parent.height - root.header-height - 36px;
        clip: true; background: #050608cc; border-radius: Theme.radius-md;
        Image {
            source: root.preview-image;
            image-fit: contain;
            width: parent.width * root.scale;
            height: parent.height * root.scale;
            x: (parent.width - self.width) / 2 + root.offset-x;
            y: (parent.height - self.height) / 2 + root.offset-y;
        }
        TouchArea {
            width: 100%; height: 100%;
            mouse-cursor: root.panning ? grabbing : default;
            scroll-event(event) => {
                let old = root.scale;
                let next = event.delta-y < 0 ? min(root.max-scale, old * root.zoom-step)
                                            : max(root.min-scale, old / root.zoom-step);
                let factor = next / old;
                root.offset-x = (self.mouse-x - self.width / 2) - (self.mouse-x - self.width / 2 - root.offset-x) * factor;
                root.offset-y = (self.mouse-y - self.height / 2) - (self.mouse-y - self.height / 2 - root.offset-y) * factor;
                root.scale = next;
                root.clamp-offset();
                accept
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.panning = true;
                    root.start-x = self.mouse-x;
                    root.start-y = self.mouse-y;
                    root.start-offset-x = root.offset-x;
                    root.start-offset-y = root.offset-y;
                } else if (event.kind == PointerEventKind.up) {
                    root.panning = false;
                }
            }
            moved => {
                if (root.panning) {
                    root.offset-x = root.start-offset-x + self.mouse-x - root.start-x;
                    root.offset-y = root.start-offset-y + self.mouse-y - root.start-y;
                    root.clamp-offset();
                }
            }
            double-clicked => {
                if (root.scale > 1.1) {
                    root.reset-view();
                } else {
                    root.scale = 2.0;
                    root.clamp-offset();
                }
            }
        }
        if root.loading : Rectangle {
            width: 100%; height: 100%;
            background: #0e1018;
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Loading image...", "Loading image...");
                    color: white; font-size: 16px; font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        if !root.loading && root.error-msg != "" : VerticalLayout {
            alignment: center;
            Text { text: root.error-msg; color: #ffb4ab; horizontal-alignment: center; }
        }
        if !root.loading && root.error-msg == "" && root.total == 0 : Text {
            text: @tr("Loading image...", "Loading image...");
            color: #d5dae4; horizontal-alignment: center; vertical-alignment: center;
        }
    }

    Rectangle {
        x: 28px; y: root.header-height + 40px; width: 44px; height: 72px;
        background: prev-ta.has-hover ? #ffffff24 : #161a22cc;
        border-radius: Theme.radius-md;
        prev-ta := TouchArea { clicked => { root.prev(); } }
        Text { text: "\u{E5CB}"; font-family: "Material Icons"; color: #f4f6fb;
               font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: parent.width - 72px; y: root.header-height + 40px; width: 44px; height: 72px;
        background: next-ta.has-hover ? #ffffff24 : #161a22cc;
        next-ta := TouchArea { clicked => { root.next(); } }
        Text { text: "\u{E5CC}"; font-family: "Material Icons"; color: #f4f6fb;
               font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
    }
    } // FocusScope
}
